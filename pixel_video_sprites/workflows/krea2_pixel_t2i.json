{
 "_template": {
  "description": "Krea 2 Turbo text-to-image (optionally with a k2-pixel LoRA) at grid x cell pixels -> MiniMax H3 Pixel Art Refiner collapses it to exactly grid_w x grid_h native pixels. Scenes: no LoRA (lora_strength 0), 4 px per art pixel (384x216 -> 1536x864). Sprites/items: k2-pixel64 at 16 px per art pixel (64x64 -> 1024x1024) or k2-pixel32 at 32 px (32x32 -> 1024x1024), white background, keyed out afterwards in Python.",
  "params": {
   "prompt": {
    "default": ""
   },
   "seed": {
    "default": 1
   },
   "width": {
    "default": 1536,
    "help": "multiple of 16 and of grid_w"
   },
   "height": {
    "default": 864,
    "help": "multiple of 16 and of grid_h"
   },
   "grid_w": {
    "default": 384
   },
   "grid_h": {
    "default": 216
   },
   "colors": {
    "default": 32,
    "help": "max colours (OKLab k-means)"
   },
   "lora": {
    "default": "k2-pixel64.safetensors"
   },
   "lora_strength": {
    "default": 0.0,
    "help": "0 = no pixel LoRA (scenes), 1 = sprites/items"
   },
   "steps": {
    "default": 8
   },
   "scheduler": {
    "default": "normal"
   },
   "auto_offset": {
    "default": false
   },
   "prefix": {
    "default": "pvs/image"
   },
   "krea_model": {
    "default": "krea2_turbo_fp8_scaled.safetensors"
   },
   "text_encoder": {
    "default": "qwen3vl_4b_fp8_scaled.safetensors"
   },
   "vae": {
    "default": "qwen_image_vae.safetensors"
   }
  }
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "{{krea_model}}",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "lora_name": "{{lora}}",
   "strength_model": "{{lora_strength}}"
  }
 },
 "3": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "{{text_encoder}}",
   "type": "krea2",
   "device": "default"
  }
 },
 "4": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "{{vae}}"
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "3",
    0
   ],
   "text": "{{prompt}}"
  }
 },
 "6": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "5",
    0
   ]
  }
 },
 "7": {
  "class_type": "EmptyLatentImage",
  "inputs": {
   "width": "{{width}}",
   "height": "{{height}}",
   "batch_size": 1
  }
 },
 "8": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "2",
    0
   ],
   "positive": [
    "5",
    0
   ],
   "negative": [
    "6",
    0
   ],
   "latent_image": [
    "7",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "{{scheduler}}",
   "denoise": 1.0
  }
 },
 "9": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "8",
    0
   ],
   "vae": [
    "4",
    0
   ]
  }
 },
 "10": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "9",
    0
   ],
   "filename_prefix": "{{prefix}}_raw"
  }
 },
 "11": {
  "class_type": "MiniMaxH3PixelArtRefiner",
  "inputs": {
   "image": [
    "9",
    0
   ],
   "width": "{{grid_w}}",
   "height": "{{grid_h}}",
   "colors": "{{colors}}",
   "color_reduction_first": true,
   "scale_to_original": false,
   "allow_uneven_grid": true,
   "shared_palette": false,
   "x_offset": 0.0,
   "y_offset": 0.0,
   "auto_offset": "{{auto_offset}}",
   "align_palette_lightness": false,
   "preserve_generated_background": true
  }
 },
 "12": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "11",
    0
   ],
   "filename_prefix": "{{prefix}}_native"
  }
 }
}